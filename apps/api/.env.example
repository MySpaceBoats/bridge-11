# Supabase — set these as Wrangler secrets (wrangler secret put KEY)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# CORS — set to your Cloudflare Pages domain
CORS_ORIGIN=https://family-bridge.pages.dev

# Set via wrangler.toml [vars] (not secret)
ENVIRONMENT=production
